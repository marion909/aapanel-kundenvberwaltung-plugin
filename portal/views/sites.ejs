<%- include('partials/header') %>
<section class="panel">
<div class="panel-head">Website<span class="muted"> · <%= quota.sites %> von <%= quota.max ? quota.max : 'unbegrenzt' %></span></div>
<div class="panel-body flush">
<% if (!sites.length) { %>
<p class="empty pad">Dir sind aktuell keine Websites zugeordnet.</p>
<% } else { %>
<table class="res">
<thead><tr><th>Domain</th><th>Status</th><th>PHP</th><th>SSL</th><th></th></tr></thead>
<tbody>
<% sites.forEach(function (s) { %>
<tr class="<%= s.state === 'missing' ? 'missing' : '' %>">
  <td><% if (s.state !== 'missing') { %><a href="/sites/<%= s.id %>"><%= s.ref_name %></a><% } else { %><%= s.ref_name %><% } %></td>
  <td>
    <% if (s.state === 'missing') { %><span class="badge warn">im Panel nicht mehr vorhanden</span>
    <% } else if (s.state === 'unknown') { %><span class="badge off">unbekannt</span>
    <% } else if (s.info.status === '0') { %><span class="badge off">gestoppt</span>
    <% } else { %><span class="badge on">läuft</span><% } %>
  </td>
  <td><%= s.info.php_version === '00' ? 'Statisch' : (s.info.php_version || '') %></td>
  <td><% if (s.info.ssl && typeof s.info.ssl === 'object') { %><span class="badge on">bis <%= s.info.ssl.notAfter %></span><% } else if (s.state === 'ok') { %><span class="badge off">nein</span><% } %></td>
  <td class="actions">
    <% if (s.state !== 'missing') { %>
      <a class="btn" href="/sites/<%= s.id %>">Verwalten</a>
      <a class="btn" href="/sites/<%= s.id %>/files">Dateien</a>
      <% if (s.info.status === '0') { %>
      <form method="post" action="/sites/<%= s.id %>/start">
        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
        <input type="hidden" name="back" value="list">
        <button type="submit" class="primary">Starten</button>
      </form>
      <% } else { %>
      <form method="post" action="/sites/<%= s.id %>/stop" data-confirm="Website „<%= s.ref_name %>“ wirklich stoppen?">
        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
        <input type="hidden" name="back" value="list">
        <button type="submit" class="danger">Stoppen</button>
      </form>
      <% } %>
    <% } %>
  </td>
</tr>
<% }) %>
</tbody>
</table>
<% } %>
</div>
</section>

<section class="panel">
<div class="panel-head">Neue Website / Subdomain anlegen</div>
<div class="panel-body">
<% if (!areas.length) { %>
<p class="empty">Dir ist noch kein Domain-Bereich zugeordnet. Bitte wende dich an den Administrator.</p>
<% } else if (quota.max && quota.sites >= quota.max) { %>
<p class="empty">Website-Limit erreicht (<%= quota.sites %> von <%= quota.max %>).</p>
<% } else { %>
<form method="post" action="/sites/new" class="panel-form" data-busy="Website wird angelegt …">
  <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
  <div class="host-input">
    <label>Subdomain (optional)
      <input type="text" name="subdomain" placeholder="z. B. shop" autocomplete="off">
    </label>
    <span class="dot">.</span>
    <label>Domain
      <select name="domain" required>
        <% areas.forEach(function (d) { %><option value="<%= d %>"><%= d %></option><% }) %>
      </select>
    </label>
  </div>
  <p class="hint">Leer lassen für die Hauptdomain. Mehrstufig möglich, z. B. <code>dev.shop</code>.</p>
  <label>PHP-Version
    <select name="php_version">
      <option value="">Neueste installierte</option>
      <% phpVersions.forEach(function (v) { %><option value="<%= v.version %>"><%= v.version === '00' ? 'Statisch (kein PHP)' : v.name %></option><% }) %>
    </select>
  </label>
  <label class="check"><input type="checkbox" name="www" value="1" checked> www-Alias hinzufügen (www.&lt;hostname&gt;)</label>
  <label class="check"><input type="checkbox" name="ssl" value="1" checked> Let's-Encrypt-SSL automatisch ausstellen</label>
  <button type="submit" class="primary">Website anlegen</button>
</form>
<% } %>
</div>
</section>
<%- include('partials/footer') %>
