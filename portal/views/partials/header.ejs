<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' ? title + ' – Kundenportal' : 'Kundenportal' %></title>
<link rel="stylesheet" href="/static/portal.css">
</head>
<% var loggedIn = typeof customer !== 'undefined' && customer; %>
<body class="<%= loggedIn ? 'app' : 'guest' %>">
<% if (loggedIn) {
  var p = typeof currentPath !== 'undefined' ? currentPath : '';
  var on = function (prefix) { return prefix === '/' ? (p === '/' ? 'on' : '') : (p.indexOf(prefix) === 0 ? 'on' : ''); };
  var icon = function (d) { return '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="' + d + '"/></svg>'; };
%>
<div class="shell">
  <aside class="side">
    <div class="side-top">
      <a class="brand" href="/">Kunden<span>Portal</span></a>
      <button type="button" class="menu-toggle" aria-label="Menü" aria-expanded="false" aria-controls="side-nav"><%- icon('M4 7h16M4 12h16M4 17h16') %></button>
    </div>
    <nav id="side-nav">
      <a href="/" class="<%= on('/') %>"><%- icon('M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z') %>Übersicht</a>
      <a href="/sites" class="<%= p.indexOf('/sites') === 0 && p.indexOf('/files') === -1 ? 'on' : '' %>"><%- icon('M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zm0 0c2.5 2.4 3.8 5.4 3.8 9s-1.3 6.6-3.8 9m0-18C9.5 5.4 8.2 8.4 8.2 12s1.3 6.6 3.8 9M3.5 9h17M3.5 15h17') %>Website</a>
      <a href="/files" class="<%= p === '/files' || /^\/sites\/\d+\/files/.test(p) ? 'on' : '' %>"><%- icon('M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z') %>Dateiverwaltung</a>
      <a href="/ssl" class="<%= on('/ssl') %>"><%- icon('M6 11V8a6 6 0 0 1 12 0v3M5 11h14v10H5z') %>SSL</a>
      <a href="/mail" class="<%= on('/mail') %>"><%- icon('M3 6h18v12H3zM3 7l9 6 9-6') %>Mailserver</a>
      <a href="/journal" class="<%= on('/journal') %>"><%- icon('M6 3h9l4 4v14H6zM9 9h6M9 13h6M9 17h4') %>Journal</a>
    </nav>
    <form method="post" action="/logout" class="side-logout">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <button type="submit"><%- icon('M15 4h4v16h-4M10 8l-4 4 4 4M6 12h11') %>abmelden</button>
    </form>
  </aside>
  <div class="content">
    <div class="topbar">
      <span class="user"><%- icon('M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm-7 9a7 7 0 0 1 14 0') %><%= customer.customer_no %></span>
      <span class="company"><%= customer.company || ((customer.first_name || '') + ' ' + (customer.last_name || '')) %></span>
      <% if (typeof appVersion !== 'undefined') { %><span class="muted version">Aktuelle Version: <%= appVersion %></span><% } %>
      <span class="grow"></span>
      <% if (customer.portal_last_login) { %><span class="muted">Letzte Anmeldung: <%= fmttime(customer.portal_last_login) %></span><% } %>
    </div>
    <main>
<% } else { %>
<main>
<% } %>
  <% if (typeof flashes !== 'undefined' && flashes && flashes.length) { %>
  <ul class="flash">
    <% flashes.forEach(function (f) { %><li class="<%= f.type %>"><%= f.message %></li><% }) %>
  </ul>
  <% } %>
